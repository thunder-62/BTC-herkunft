# BTC-Herkunft (btc-origin) — non-secret local settings only
# Copy to .env and adjust. Never put seeds, private keys, or passwords here.
#
# HARD BOUNDARY: durable storage is forbidden. Session = process memory only.
# Do NOT set SQLITE_PATH to a file. File DBs are out of scope / ignored.

# Electrum server (public read-only). SSL port is typically 50002.
# Sync tries this host first, then fails over across DEFAULT_ELECTRUM_SERVERS.
# Public servers may block some networks. Status: GET /api/electrum/status?probe=1
# See GET /api/electrum/servers for the default list.
ELECTRUM_HOST=electrum.blockstream.info
ELECTRUM_PORT=50002
ELECTRUM_SSL=true

# In-memory SQLite only (process lifetime). File paths are NOT supported.
# SQLITE_PATH=:memory:

# Address gap limit for HD derivation from xpub
GAP_LIMIT=20
# Heuristische Ownership (Co-Spend/Change) — Default aus: nur eingefügte xpubs zählen als eigen.
# OWNERSHIP_INFERENCE=true

# Bind address — localhost only by default (do not expose publicly without review)
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Optional: public BTC reference-price Oracle (no API key). Used only on
# explicit report Save/Print — never persisted. Default = CoinGecko.
# PRICE_ORACLE_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd,eur

# Reverse-provenance BFS depth cap (TraceEngine). Never unbounded.
# TRACE_MAX_DEPTH=5
